# Neon application traffic uses the pooled URL; migrations use the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Object Storage supplies standard S3-compatible variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=aws-ap-southeast-1

INCIDENT_DESK_ATTACHMENT_BUCKET=incident-attachments
INCIDENT_DESK_NEON_REQUIRED=false
