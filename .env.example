# Neon application traffic uses the pooled URL; migrations use the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Object Storage supplies standard S3-compatible variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=aws-ap-southeast-1

INCIDENT_DESK_ATTACHMENT_BUCKET=incident-attachments
INCIDENT_DESK_NEON_REQUIRED=false

# One-time first-administrator bootstrap. Remove both values immediately after
# the first successful startup. Never commit real values.
INCIDENT_DESK_BOOTSTRAP_ADMIN_LOGIN=
INCIDENT_DESK_BOOTSTRAP_ADMIN_PASSWORD=

# Local HTTP development may set this false. Production remains true.
INCIDENT_DESK_SECURE_COOKIES=true
