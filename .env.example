# Neon application traffic uses the pooled URL; migrations use the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Object Storage supplies standard S3-compatible variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=aws-ap-southeast-1

INCIDENT_DESK_ATTACHMENT_BUCKET=incident-attachments
INCIDENT_DESK_NEON_REQUIRED=false

# One-time first-administrator bootstrap. Remove both values immediately after
# the first successful startup. Never commit real values.
INCIDENT_DESK_BOOTSTRAP_ADMIN_LOGIN=
INCIDENT_DESK_BOOTSTRAP_ADMIN_PASSWORD=

# Local HTTP development may set this false. Production remains true.
INCIDENT_DESK_SECURE_COOKIES=true

# Provider adapter only. Leave disabled until shared admission, authorization,
# audit, and release verification are integrated. Never commit a real API key.
AI_ENABLED=false
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
SOCLAAS_MODEL=
# Optional downward-only limits (milliseconds, bytes, and tokens respectively).
AI_CONNECT_TIMEOUT_MS=3000
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_INPUT_BYTES=16384
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_BYTES=16384
AI_MAX_OUTPUT_TOKENS=1200
