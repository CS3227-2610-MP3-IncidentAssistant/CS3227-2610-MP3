# Copy this file to .env.test.local and use only an empty, dedicated test project.
# `neon env pull --file .env.test.local --services postgres --services object-storage`
# supplies these standard variables. Tests use DATABASE_URL_UNPOOLED as the
# direct migration/test connection; its hostname must not contain "-pooler".
DATABASE_URL=postgresql://your_database_username:your_database_password@your-test-endpoint-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://your_database_username:your_database_password@your-test-endpoint.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=your_test_access_key_id
AWS_SECRET_ACCESS_KEY=your_test_secret_access_key
AWS_ENDPOINT_URL_S3=https://your-test-storage-endpoint.example
AWS_REGION=ap-southeast-1
INCIDENT_DESK_ATTACHMENT_BUCKET=incident-attachments
INCIDENT_DESK_NEON_REQUIRED=true

# Required acknowledgement because the tests create and drop isolated schemas.
INCIDENT_DESK_TEST_DATABASE_CONFIRM_ISOLATED=true
