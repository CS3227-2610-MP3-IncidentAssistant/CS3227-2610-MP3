# Copy this file to .env.test.local and use only an empty, dedicated test database.
# Use a direct Neon endpoint (the hostname must not contain "-pooler").
INCIDENT_DESK_TEST_DATABASE_URL=postgresql://your_database_username:your_database_password@your-test-endpoint.neon.tech/neondb?sslmode=require

# Required acknowledgement because the tests create and drop isolated schemas.
INCIDENT_DESK_TEST_DATABASE_CONFIRM_ISOLATED=true
